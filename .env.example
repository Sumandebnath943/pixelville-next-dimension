# Copy to .env.local (never committed) and fill in.
# Used by the villager AI chat proxy (api/chat.ts, api/_chat.ts) from Milestone 3.
# In production, set the same names in the Vercel project's environment variables.
# Without a key, villagers answer with template dialogue from their own minds.
GROQ_API_KEY=
# Optional: a Groq model id. Left empty, the proxy tries a small Llama model and,
# if Groq has retired it, picks a current chat model from Groq's model list.
GROQ_MODEL=
# Optional (launch): other sites allowed to call the chat proxy, comma-separated origins or hosts
# (the site itself and localhost always are), and the server's own daily cap on chat requests.
CHAT_ORIGINS=
CHAT_DAILY_CAP=4000
